# Ollama adresi (host'ta çalışıyorsa)
LLMPERF_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Örnekleme aralığı (saniye)
LLMPERF_POLL_INTERVAL_SEC=0.4

# Panel portu — bridge / Mac Docker compose için
# LLMPERF_PORT=8080

# Bridge / Mac Docker: slots host (genelde host.docker.internal)
# LLMPERF_SLOTS_HOST=host.docker.internal

# Mac Docker: bilinen /slots portları (opsiyonel; install script dosyaya yazar)
# LLMPERF_SLOTS_PORTS=
# LLMPERF_SLOTS_PORTS_FILE=/app/.slots-ports
# LLMPERF_SLOTS_DISCOVER=false
